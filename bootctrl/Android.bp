// AIDL boot control HAL over the legacy bootctrl.qcom slot handling. The
// QTI implementation does not work on payton, and Android 17 no longer
// talks to HIDL boot control 1.1 and older.

cc_defaults {
    name: "android.hardware.boot-service.payton_defaults",
    relative_install_path: "hw",
    srcs: [
        "boot_control.cpp",
        "BootControl.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "android.hardware.boot-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libz",
    ],
    static_libs: ["libgptutils.payton"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_binary {
    name: "android.hardware.boot-service.payton",
    defaults: ["android.hardware.boot-service.payton_defaults"],
    vendor: true,
    init_rc: ["android.hardware.boot-service.payton.rc"],
    vintf_fragments: ["android.hardware.boot-service.payton.xml"],
}

cc_binary {
    name: "android.hardware.boot-service.payton.recovery",
    defaults: ["android.hardware.boot-service.payton_defaults"],
    recovery: true,
    init_rc: ["android.hardware.boot-service.payton.recovery.rc"],
    vintf_fragments: ["android.hardware.boot-service.payton.xml"],
}
