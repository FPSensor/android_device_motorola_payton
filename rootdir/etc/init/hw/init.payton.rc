on post-fs
    symlink /dev/block/mmcblk0p64 /dev/block/by-name/vendor_b
    symlink /dev/block/mmcblk0p63 /dev/block/by-name/vendor_a
    symlink /dev/block/mmcblk0p64 /dev/block/bootdevice/by-name/vendor_b
    symlink /dev/block/mmcblk0p63 /dev/block/bootdevice/by-name/vendor_a

    # The FPC HAL looks for the sensor under /sys/devices/soc, which moved to
    # /sys/devices/platform/soc on kernel 4.19. Its path is patched to this
    # link (extract-files.py).
    symlink /sys/devices/platform/soc /dev/fpc_soc

on post-fs-data
    mkdir /data/.fps 0770 system system

    # Keep the previous boot pstore records (kernel console, Android pmsg,
    # panic dmesg) in /data, since ramoops is overwritten on every boot
    mkdir /data/vendor/pstore 0750 root log
    copy /sys/fs/pstore/console-ramoops-0 /data/vendor/pstore/console-ramoops-0
    copy /sys/fs/pstore/pmsg-ramoops-0 /data/vendor/pstore/pmsg-ramoops-0
    copy /sys/fs/pstore/dmesg-ramoops-0 /data/vendor/pstore/dmesg-ramoops-0
    copy /sys/fs/pstore/dmesg-ramoops-1 /data/vendor/pstore/dmesg-ramoops-1
    chown root log /data/vendor/pstore/console-ramoops-0
    chown root log /data/vendor/pstore/pmsg-ramoops-0
    chown root log /data/vendor/pstore/dmesg-ramoops-0
    chown root log /data/vendor/pstore/dmesg-ramoops-1
    chmod 0640 /data/vendor/pstore/console-ramoops-0
    chmod 0640 /data/vendor/pstore/pmsg-ramoops-0
    chmod 0640 /data/vendor/pstore/dmesg-ramoops-0
    chmod 0640 /data/vendor/pstore/dmesg-ramoops-1

# I/O scheduler: BFQ keeps foreground reads responsive while apps install
# or update in the background. eMMC and SD go through blk-mq on 4.19,
# where the default is mq-deadline.
on boot
    write /sys/block/mmcblk0/queue/scheduler bfq
    write /sys/block/mmcblk1/queue/scheduler bfq

# uclamp (kernel 4.19 has no schedtune). Values from the sdm660 lavender
# tuning: everything boosted while booting, then background work capped
# so it stays on the lower frequencies and top-app tasks prefer idle CPUs.
on init
    # WALT colocation of the top-app threads (was schedtune.colocate)
    write /dev/cpuctl/top-app/cpu.uclamp.colocate 1
    write /dev/cpuctl/background/cpu.uclamp.min 100
    write /dev/cpuctl/camera-daemon/cpu.uclamp.min 100
    write /dev/cpuctl/dex2oat/cpu.uclamp.min 100
    write /dev/cpuctl/foreground/cpu.uclamp.min 100
    write /dev/cpuctl/foreground_window/cpu.uclamp.min 100
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.min 100
    write /dev/cpuctl/rt/cpu.uclamp.min 100
    write /dev/cpuctl/system/cpu.uclamp.min 100
    write /dev/cpuctl/system-background/cpu.uclamp.min 100
    write /dev/cpuctl/top-app/cpu.uclamp.min 100

on property:sys.boot_completed=1
    write /dev/cpuctl/background/cpu.uclamp.max 70
    write /dev/cpuctl/background/cpu.uclamp.min 0
    write /dev/cpuctl/background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/camera-daemon/cpu.uclamp.max max
    write /dev/cpuctl/camera-daemon/cpu.uclamp.min 0
    write /dev/cpuctl/camera-daemon/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/dex2oat/cpu.uclamp.max max
    write /dev/cpuctl/dex2oat/cpu.uclamp.min 20
    write /dev/cpuctl/dex2oat/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/foreground/cpu.uclamp.max 70
    write /dev/cpuctl/foreground/cpu.uclamp.min 0
    write /dev/cpuctl/foreground/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/foreground_window/cpu.uclamp.max 70
    write /dev/cpuctl/foreground_window/cpu.uclamp.min 0
    write /dev/cpuctl/foreground_window/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.max max
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.min 0
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/rt/cpu.uclamp.max max
    write /dev/cpuctl/rt/cpu.uclamp.min 0
    write /dev/cpuctl/rt/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/system/cpu.uclamp.max 80
    write /dev/cpuctl/system/cpu.uclamp.min 0
    write /dev/cpuctl/system/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/system-background/cpu.uclamp.max 70
    write /dev/cpuctl/system-background/cpu.uclamp.min 0
    write /dev/cpuctl/system-background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/top-app/cpu.uclamp.max max
    write /dev/cpuctl/top-app/cpu.uclamp.min 0
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1

on moto-charger
    setprop ro.board.platform sdm660
